# Tessolve Executive Portal - Environment Configuration
# Copy this to .env and fill in your values

# Application
APP_NAME=Tessolve Executive Portal
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database - PostgreSQL Configuration
# Option 1: Use individual components (recommended)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tessolve_portal
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_ECHO=false

# Option 2: Use full DATABASE_URL (overrides individual components if set)
# DATABASE_URL=postgresql://user:password@localhost:5432/tessolve_portal

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Policy
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
